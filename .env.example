# Copy values into backend/.env and frontend/.env — never commit real secrets.

MONGODB_URI=      # MongoDB Atlas connection string (free tier)
GROQ_API_KEY=      # Groq free-tier API key (classification/summarization)
HF_API_KEY=        # Hugging Face free-tier API key (Inference Providers — embeddings)
PORT=3001

# Frontend (Vite) — used by frontend/.env
VITE_API_URL=http://localhost:3001
